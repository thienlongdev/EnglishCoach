# Node 20 left upstream support in April 2026; 24 is the supported LTS line this project is developed on.
FROM node:24-alpine AS build
WORKDIR /app

# Build-time argument for Next.js client-side bundle compilation
# In production, same-origin API routing (/api/v1) is used through Nginx
ARG NEXT_PUBLIC_API_URL=/api/v1
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

ARG NEXT_PUBLIC_TURNSTILE_SITE_KEY
ENV NEXT_PUBLIC_TURNSTILE_SITE_KEY=$NEXT_PUBLIC_TURNSTILE_SITE_KEY

ARG NEXT_PUBLIC_TRANSLATION_PARAGRAPH_ENABLED=true
ENV NEXT_PUBLIC_TRANSLATION_PARAGRAPH_ENABLED=$NEXT_PUBLIC_TRANSLATION_PARAGRAPH_ENABLED

# Production Build Guard: Reject missing or Cloudflare test/dummy site keys
RUN if [ -z "$NEXT_PUBLIC_TURNSTILE_SITE_KEY" ] || \
       echo "$NEXT_PUBLIC_TURNSTILE_SITE_KEY" | grep -qE '^([123]x0000000000|0000000000)'; then \
       echo "================================================================================" >&2 && \
       echo "FATAL [Turnstile Production Build Guard]: Production build requires a real Turnstile site key!" >&2 && \
       echo "NEXT_PUBLIC_TURNSTILE_SITE_KEY is empty or contains a Cloudflare test dummy key." >&2 && \
       echo "Build aborted to prevent test key leak into production." >&2 && \
       echo "================================================================================" >&2 && \
       exit 1; \
    fi

# Exactly the versions of package-lock.json; fails when the manifest and the lockfile disagree.
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .

# vitest.config.ts is local test configuration; remove so next build typecheck ignores it
RUN rm -f vitest.config.ts

RUN npm run build

# Post-Build Artifact Guard: Scan static chunks for any test site key
RUN if grep -rnE '[123]x0000000000' .next/static; then \
       echo "================================================================================" >&2 && \
       echo "FATAL [Turnstile Post-Build Guard]: Cloudflare test site key found in .next/static!" >&2 && \
       echo "Build aborted to prevent test key deployment." >&2 && \
       echo "================================================================================" >&2 && \
       exit 1; \
    fi

# The compiler cache is not part of the artifact.
RUN rm -rf .next/cache

# Runtime image: production dependencies, the build output and the public files only. No source tree, no build
# cache, no development dependency; the server runs as the unprivileged `node` user.
FROM node:24-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

COPY package.json package-lock.json ./
# The server starts with `node` directly: the package managers of the base image (npm, its bundled dependencies,
# corepack, yarn) are not needed at run time and carried advisories of their own (security closure 2026-10).
RUN npm ci --omit=dev --no-audit --no-fund && npm cache clean --force  && rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /usr/local/bin/npm /usr/local/bin/npx            /usr/local/bin/corepack /opt/yarn-* /usr/local/bin/yarn /usr/local/bin/yarnpkg

COPY --from=build /app/next.config.ts /app/tsconfig.json ./
COPY --from=build /app/public ./public
COPY --from=build /app/.next ./.next
# The only directory the server writes to (optimized-image and fetch cache).
RUN mkdir -p .next/cache && chown -R node:node .next/cache

USER node
EXPOSE 3000
CMD ["node", "node_modules/next/dist/bin/next", "start"]
