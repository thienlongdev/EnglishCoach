# ==============================================================================
# ENGLISH COACH - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.production on the Azure VPS and fill in the values.
# NEVER commit real production secrets, credentials, or private keys to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (Azure Database for PostgreSQL Flexible Server)
# External PostgreSQL 17 managed database.
# sslmode=require is mandatory for Azure Flexible Server.
# ------------------------------------------------------------------------------
# Server certificate AND host name verified against the JVM trust store (Azure chains to DigiCert Global Root G2).
DB_URL=jdbc:postgresql://<AZURE_POSTGRES_HOST>.postgres.database.azure.com:5432/english_coach?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory
DB_USER=<YOUR_AZURE_POSTGRES_ADMIN_USER>
DB_PASSWORD=<YOUR_AZURE_POSTGRES_STRONG_PASSWORD>

# ------------------------------------------------------------------------------
# 2. BACKEND (Spring Boot Java 21)
# ------------------------------------------------------------------------------
PORT=8080
# JVM memory allocation optimized for ~1 GB RAM VPS (leaves headroom for Next.js & OS)
JAVA_TOOL_OPTIONS=-Xms96m -Xmx288m -XX:NewRatio=6 -XX:+UseSerialGC -XX:TieredStopAtLevel=1 -Xlog:gc
SPRING_PROFILES_ACTIVE=prod
CORS_ALLOWED_ORIGINS=https://englishcoach.io.vn,https://www.englishcoach.io.vn
APP_BASE_URL=https://englishcoach.io.vn

# Exam system settings
APP_EXAMS_ENABLED=true
APP_WRITING_ENABLED=true
EXAMS_STORAGE_TYPE=local
EXAMS_LOCAL_STORAGE_DIR=storage/exams
EXAMS_AI_INTERNAL_KEY=ec-internal-exam-key-replace-with-random-secret

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION (NextAuth.js & Spring Boot JWT)
# AUTH_JWT_SECRET signs the backend's HS256 API tokens (backend only; never given to the frontend).
# Generate with: openssl rand -base64 48
# ------------------------------------------------------------------------------
AUTH_JWT_SECRET=replace-with-a-very-long-random-secret-key-at-least-64-characters-long
NEXTAUTH_SECRET=replace-with-a-separate-random-secret-for-nextauth-session-cookies
# NEXTAUTH_URL must be the full public origin accessible by the browser (https://englishcoach.io.vn)
NEXTAUTH_URL=https://englishcoach.io.vn

# Optional: Google OAuth (leave empty or fill if Google Sign-In is configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Purpose keys and administrator second factor (security closure, 2026-10). Never print these values.
# - AUTH_JWT_SECRET (above) is read by the BACKEND only. The frontend container no longer receives this file: it
#   gets exactly NEXTAUTH_URL, NEXTAUTH_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, the Turnstile site key and
#   APP_SECURITY_INTERNAL_SERVICE_KEY through docker-compose.prod.yml.
# - APP_SECURITY_INTERNAL_SERVICE_KEY (REQUIRED in production, 32+ random characters, e.g. `openssl rand -hex 32`):
#   the frontend server signs its calls to the backend's token-issuing endpoints with it (body-bound, single-use).
#   Both containers need the same value. Production refuses to start without it, or if it equals another key.
# - APP_SECURITY_MFA_ENCRYPTION_KEY (REQUIRED in production, 32+ random characters, backend only): encrypts the
#   authenticator-app seed at rest. Independent of AUTH_JWT_SECRET, so rotating that one no longer strands the seed.
#   Losing this key = the administrator re-enrols the authenticator app (passkeys and recovery codes still work).
# - APP_SECURITY_ALERT_EMAIL: where security alerts are mailed (backend start, second-factor changes, emergency reset,
#   unmatched payments, refusal bursts). Blank: alerts go to the backend log only.
# - APP_SECURITY_ADMIN_MFA_REQUIRED=true also refuses an administrator who has NOT enrolled a second factor yet
#   (an enrolled factor is always demanded, whatever this says). Set it after the owner has enrolled.
# - APP_SECURITY_ADMIN_MFA_EMERGENCY_RESET_TOKEN: owner runbook only. A fresh random value (32+ characters) removes
#   the administrator's second factors ONCE at the next backend start. Remove the line afterwards.
# - Production has NO unsigned window on the token-issuing endpoints (APP_SECURITY_INTERNAL_AUTH_ENFORCE_AFTER is
#   ignored there); a rollback therefore rolls the backend and the frontend back TOGETHER (runbook 10).
APP_SECURITY_INTERNAL_SERVICE_KEY=
APP_SECURITY_MFA_ENCRYPTION_KEY=
APP_SECURITY_ALERT_EMAIL=
#APP_SECURITY_ADMIN_MFA_REQUIRED=true
#APP_SECURITY_ADMIN_MFA_EMERGENCY_RESET_TOKEN=

# ------------------------------------------------------------------------------
# CLOUDFLARE TURNSTILE (Anti-bot Protection)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY is a BUILD-TIME variable baked into client bundles.
# TURNSTILE_SECRET_KEY is a server-side RUNTIME secret (never baked into images).
# In production, TURNSTILE_ENABLED and TURNSTILE_REQUIRED must both be true.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<YOUR_CLOUDFLARE_TURNSTILE_PUBLIC_SITE_KEY>
TURNSTILE_ENABLED=true
TURNSTILE_REQUIRED=true
TURNSTILE_SECRET_KEY=<YOUR_CLOUDFLARE_TURNSTILE_SECRET_KEY>

# ------------------------------------------------------------------------------
# 4. FRONTEND (Next.js 15)
# ------------------------------------------------------------------------------
# In production, same-origin API routing is used through Nginx reverse proxy.
# This relative path is baked into client bundles at build time via Dockerfile.prod.
NEXT_PUBLIC_API_URL=/api/v1
BACKEND_INTERNAL_URL=http://backend:8080
NODE_ENV=production

# ------------------------------------------------------------------------------
# 5. AI / TAILSCALE (Remote Windows GPU PC)
# Spring Boot connects to the AI service running on the Windows GPU PC via Tailscale.
# Do NOT use public IPs; use the private Tailscale IP (e.g. 100.x.y.z) or Tailscale MagicDNS name.
# Ports 8000 and 8010 are NEVER exposed to the public Internet.
# ------------------------------------------------------------------------------
AI_SERVICE_URL=http://<WINDOWS_GPU_PC_TAILSCALE_IP>:8000
AI_TIMEOUT_CONNECT=10000
AI_TIMEOUT_READ=120000

# ------------------------------------------------------------------------------
# 6. EXTERNAL LLM / STT (OpenRouter / OpenAI)
# Used for writing evaluation and LLM generation features.
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_MODEL=google/gemini-2.0-flash-001
SENTENCE_LAB_MODEL=openai/gpt-5.6-luna
SENTENCE_LAB_FALLBACK_MODEL=deepseek/deepseek-v3.2
STT_MODEL=openai/whisper-1

# ------------------------------------------------------------------------------
# 7. DOMAIN & NGINX
# ------------------------------------------------------------------------------
DOMAIN=englishcoach.io.vn
SERVER_NAME=englishcoach.io.vn www.englishcoach.io.vn

# ------------------------------------------------------------------------------
# 8. PAYMENT & SEPAY (Phase E)
# Webhook secret is confidential and configured in the SePay dashboard.
# Bank details must match the configured receiving account for English Coach.
# If unconfigured, production payment remains NOT_CONFIGURED.
# ------------------------------------------------------------------------------
SEPAY_ENV=LIVE
SEPAY_WEBHOOK_SECRET=
PREMIUM_PAYMENT_BANK_CODE=
PREMIUM_PAYMENT_ACCOUNT_NUMBER=
PREMIUM_PAYMENT_ACCOUNT_NAME=
PREMIUM_PAYMENT_CODE_PREFIX=EC
PREMIUM_PAYMENT_ORDER_TTL_MINUTES=20


# King snapshot release: operator-owned host packages/state, both mounted read-only.
# Provision these directories before backend recreation; never use a LOCAL_TEST ledger.
KING_SNAPSHOT_HOST_ROOT=./king

# Optional Grammar Professor remains disabled; enabling requires explicit owner authorization.
GRAMMAR_PROFESSOR_ENABLED=false

# Echo Anywhere: official Chrome store ID + explicitly authorized development ID (Edge ID pending).
APP_ECHO_ANYWHERE_EXTENSION_IDS=gohhmbiobjnfnkagkklffajggkmgegod,kfepndgiddgljieglnilcaadlcgmdghj
