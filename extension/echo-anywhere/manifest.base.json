{
  "manifest_version": 3,
  "name": "Echo Anywhere — English Coach",
  "short_name": "Echo Anywhere",
  "version": "1.0.1",
  "description": "Học tiếng Anh ngay trên mọi trang web: tra nghĩa theo ngữ cảnh, phát âm, lưu Thẻ từ vựng và Vũ trụ tri thức của English Coach.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Echo Anywhere",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "__SITE__/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "externally_connectable": {
    "matches": [
      "__SITE__/*"
    ]
  },
  "commands": {
    "echo-lookup": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Tra nghĩa đoạn đang chọn"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/echo-128.webp",
        "fonts/quicksand-latin.woff2",
        "fonts/quicksand-vietnamese.woff2"
      ],
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "use_dynamic_url": true
    }
  ]
}
